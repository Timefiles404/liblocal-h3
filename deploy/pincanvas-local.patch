+/**
+ * 把画布的节点语义翻译成本地 H3 的任务参数。
+ *
+ * 放在单独一层的原因：`useGenerationTrigger` 里已经有大量按云端模型分支的逻辑，
+ * 本地渠道不应该再往里塞第三套。上层只需在入口判断 provider 后调用这里。
+ */
+import type { ModelDef } from '@/types/model';
+import { getAllParameterValues } from '@/utils/modelParams';
+import {
+  firstOutputUrl,
+  runLocal,
+  stageImageForLocal,
+  type LocalGenerateParams,
+  type LocalJob,
+} from './local';
+
+export interface LocalRunContext {
+  model: ModelDef;
+  prompt: string;
+  /** 画布上游连接的参考图（dataURL / blob / http 均可）。 */
+  referenceImages?: string[];
+  ratio?: string;
+  /** 'first-last-frame' 走 fl2va 锚定；其余按 ref2va 参考处理。 */
+  videoMode?: 'first-last-frame' | 'omni-reference';
+  signal?: AbortSignal;
+  onProgress?: (job: LocalJob) => void;
+}
+
+type ParamBag = Record<string, string | number | boolean>;
+
+function readParams(model: ModelDef): ParamBag {
+  if (!model.parameters?.length) return {};
+  return getAllParameterValues(model.id, model.parameters);
+}
+
+function num(bag: ParamBag, key: string): number | undefined {
+  const v = bag[key];
+  if (typeof v === 'number' && Number.isFinite(v)) return v;
+  if (typeof v === 'string' && v.trim() !== '' && Number.isFinite(Number(v))) return Number(v);
+  return undefined;
+}
+
+function str(bag: ParamBag, key: string): string | undefined {
+  const v = bag[key];
+  return typeof v === 'string' && v ? v : undefined;
+}
+
+function bool(bag: ParamBag, key: string): boolean | undefined {
+  return typeof bag[key] === 'boolean' ? (bag[key] as boolean) : undefined;
+}
+
+/** 把模型参数面板上的值折叠成一次生成请求的公共部分。 */
+function baseParams(model: ModelDef, ratio?: string): Partial<LocalGenerateParams> {
+  const bag = readParams(model);
+  const seed = num(bag, 'seed');
+  return {
+    profile: str(bag, 'profile'),
+    aspect: ratio,
+    steps: num(bag, 'steps'),
+    // 面板上用 -1 表示随机；后端以 null 表示随机。
+    seed: seed === undefined || seed < 0 ? null : seed,
+    sampler: str(bag, 'sampler'),
+    scheduler: str(bag, 'scheduler'),
+    useTurboLora: bool(bag, 'useTurboLora'),
+    loraStrength: num(bag, 'loraStrength'),
+    shiftVideo: num(bag, 'shiftVideo'),
+    shiftAudio: num(bag, 'shiftAudio'),
+  };
+}
+
+async function stageAll(urls: string[], limit: number): Promise<string[]> {
+  const picked = urls.slice(0, limit);
+  return Promise.all(picked.map((u) => stageImageForLocal(u)));
+}
+
+/**
+ * 本地出图。带参考图时走 ref2va，而不是把参考图锚定成首帧——后者取回第 0 帧
+ * 只会得到原图。
+ */
+export async function runLocalImage(ctx: LocalRunContext): Promise<string[]> {
+  const refs = ctx.referenceImages?.length ? await stageAll(ctx.referenceImages, 9) : [];
+  const job = await runLocal({
+    ...baseParams(ctx.model, ctx.ratio),
+    kind: 'image',
+    prompt: ctx.prompt,
+    refImages: refs,
+    signal: ctx.signal,
+    onProgress: ctx.onProgress,
+    label: '出图',
+  });
+  const urls = job.outputs.filter((o) => o.kind === 'image').map((o) => o.url);
+  if (urls.length === 0) {
+    const fallback = firstOutputUrl(job, 'image');
+    if (fallback) return [fallback];
+    throw new Error('本地生成未返回图片');
+  }
+  return urls;
+}
+
+/** 本地出视频（含 H3 的原生音频）。 */
+export async function runLocalVideo(ctx: LocalRunContext): Promise<string> {
+  const bag = readParams(ctx.model);
+  const refsIn = ctx.referenceImages ?? [];
+  const params: Parwarning: in the working copy of 'src/api/local.ts', LF will be replaced by CRLF the next time Git touches it
tial<LocalGenerateParams> = {
+    ...baseParams(ctx.model, ctx.ratio),
+    length: num(bag, 'length') ?? 124,
+    withAudio: bool(bag, 'withAudio') ?? true,
+  };
+
+  if (ctx.videoMode === 'first-last-frame') {
+    if (refsIn.length < 2) throw new Error('首尾帧模式需要连接至少 2 张参考图');
+    const [first, last] = await stageAll(refsIn.slice(0, 2), 2);
+    params.firstFrame = first;
+    params.lastFrame = last;
+  } else if (refsIn.length === 1) {
+    // 单张参考图按“指定首帧”理解，这是画布上最常见的意图。
+    params.firstFrame = (await stageAll(refsIn, 1))[0];
+  } else if (refsIn.length > 1) {
+    params.refImages = await stageAll(refsIn, 9);
+  }
+
+  const job = await runLocal({
+    ...params,
+    kind: 'video',
+    prompt: ctx.prompt,
+    signal: ctx.signal,
+    onProgress: ctx.onProgress,
+    label: '视频',
+  });
+  const url = firstOutputUrl(job, 'video');
+  if (!url) throw new Error('本地生成未返回视频');
+  return url;
+}
+
+export function isLocalModel(model: ModelDef | undefined | null): boolean {
+  return model?.provider === 'local';
+}
