new file mode 100644
index 0000000..4bbff53
--- /dev/null
+++ b/src/components/LocalRuntimePanel.tsx
@@ -0,0 +1,324 @@
+/**
+ * 本地运行时面板：把 ComfyUI 的进程状态、显存占用和当前任务摊开给用户。
+ *
+ * 存在的理由是“小白可用”：本地生成的失败大多来自进程没起来、显存不够或模型
+ * 缺文件，而这些在云端 API 模式下是不存在的概念。与其让用户去读控制台，
+ * 不如把状态和一两个可操作的按钮放在界面里。
+ */
+import { Activity, CircleStop, Play, RefreshCw, Trash2, X } from 'lucide-react';
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+import {
+  freeComfyVram,
+  getComfyLogs,
+  getLocalHealth,
+  getLocalStatus,
+  restartComfy,
+  startComfy,
+  stopComfy,
+  type LocalComfyStatus,
+  type LocalHealth,
+  type LocalJob,
+} from '@/api/local';
+
+const STATE_LABEL: Record<LocalComfyStatus['state'], string> = {
+  stopped: '未启动',
+  starting: '启动中',
+  ready: '就绪',
+  stopping: '停止中',
+  crashed: '已崩溃',
+};
+
+const STATE_TONE: Record<LocalComfyStatus['state'], string> = {
+  stopped: 'bg-zinc-300',
+  starting: 'bg-amber-400 animate-pulse',
+  ready: 'bg-emerald-500',
+  stopping: 'bg-amber-400 animate-pulse',
+  crashed: 'bg-red-500',
+};
+
+function fmtDuration(secs: number | null | undefined): string {
+  if (!secs || secs < 0) return '—';
+  if (secs < 60) return `${secs.toFixed(0)} 秒`;
+  const m = Math.floor(secs / 60);
+  return `${m} 分 ${Math.round(secs - m * 60)} 秒`;
+}
+
+/**
+ * 常驻状态徽章。本地生成最常见的困惑是“点了生成，但什么也没发生”——
+ * 其实是 ComfyUI 正在冷启动或加载 28GB 权重。把状态一直摆在画布角上，
+ * 用户不必猜。
+ */
+export function LocalRuntimeBadge({ onClick }: { onClick: () => void }) {
+  const [comfy, setComfy] = useState<LocalComfyStatus | null>(null);
+  const [current, setCurrent] = useState<LocalJob | null>(null);
+  const [reachable, setReachable] = useState(true);
+
+  useEffect(() => {
+    let alive = true;
+    const pull = async () => {
+      try {
+        const s = await getLocalStatus();
+        if (!alive) return;
+        setComfy(s.comfy);
+        setCurrent(s.current);
+        setReachable(true);
+      } catch {
+        if (alive) setReachable(false);
+      }
+    };
+    void pull();
+    const t = window.setInterval(pull, 3000);
+    return () => {
+      alive = false;
+      window.clearInterval(t);
+    };
+  }, []);
+
+  if (!reachable) {
+    return (
+      <button
+        type="button"
+        onClick={onClick}
+        className="pointer-events-auto flex items-center gap-1.5 rounded-full border border-red-200 bg-white/95 px-3 py-1.5 text-[12px] font-medium text-red-600 shadow-sm backdrop-blur"
+      >
+        <span className="h-2 w-2 rounded-full bg-red-500" />
+        本地服务未连接
+      </button>
+    );
+  }
+
+  const label = current
+    ? current.state === 'preparing'
+      ? '加载模型…'
+      : `生成中 ${current.step}/${current.totalSteps}`
+    : comfy
+      ? `本地引擎 ${STATE_LABEL[comfy.state]}`
+      : '本地引擎 …';
+
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      title="查看本地运行时状态"
+      className="pointer-events-auto flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white/95 px-3 py-1.5 text-[12px] font-medium text-zinc-700 shadow-sm backdrop-blur hover:bg-white"
+    >
+      <span className={`h-2 w-2 rounded-full ${comfy ? STATE_TONE[comfy.state] : 'bg-zinc-300'}`} />
+      {label}
+    </button>
+  );
+}
+
+export function LocalRuntimePanel({ onClose }: { onClose: () => void }) {
+  const [health, setHealth] = useState<LocalHealth | null>(null);
+  const [comfy, setComfy] = useState<LocalComfyStatus | null>(null);
+  const [current, setCurrent] = useState<LocalJob | null>(null);
+  const [queued, setQueued] = useState(0);
+  const [logs, setLogs] = useState<string[]>([]);
+  const [showLogs, setShowLogs] = useState(false);
+  const [busy, setBusy] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const logRef = useRef<HTMLDivElement | null>(null);
+
+  const refresh = useCallback(async () => {
+    try {
+      const s = await getLocalStatus();
+      setComfy(s.comfy);
+      setCurrent(s.current);
+      setQueued(s.queued);
+      setError(null);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    }
+  }, []);
+
+  useEffect(() => {
+    getLocalHealth().then(setHealth).catch(() => undefined);
+    void refresh();
+    // 轮询而不是长连接：这个面板通常只开几秒，2 秒一次已经够灵敏。
+    const t = window.setInterval(refresh, 2000);
+    return () => window.clearInterval(t);
+  }, [refresh]);
+
+  useEffect(() => {
+    if (!showLogs) return;
+    let alive = true;
+    const pull = () =>
+      getComfyLogs(200)
+        .then((r) => {
+          if (alive) setLogs(r.logs.map((l) => l.text));
+        })
+        .catch(() => undefined);
+    void pull();
+    const t = window.setInterval(pull, 2000);
+    return () => {
+      alive = false;
+      window.clearInterval(t);
+    };
+  }, [showLogs]);
+
+  useEffect(() => {
+    if (showLogs && logRef.current) logRef.current.scrollTop = logRef.current.scrollHeight;
+  }, [logs, showLogs]);
+
+  const act = async (name: string, fn: () => Promise<unknown>) => {
+    setBusy(name);
+    setError(null);
+    try {
+      await fn();
+      await refresh();
+    } catch (e) {
+      setError(e instanceof Error ? e.message : String(e));
+    } finally {
+      setBusy(null);
+    }
+  };
+
+  const gpu = health?.host.gpu;
+  const missing = health?.missing ?? [];
+
+  return (
+    <div className="fixed right-4 top-16 z-50 w-[380px] rounded-2xl border border-zinc-200 bg-white p-4 shadow-[0_20px_60px_rgba(15,23,42,0.18)]">
+      <div className="mb-3 flex items-center justify-between">
+        <div className="flex items-center gap-2 text-sm font-semibold text-zinc-800">
+          <Activity className="h-4 w-4" />
+          本地运行时
+        </div>
+        <button
+          type="button"
+          onClick={onClose}
+          className="rounded p-1 text-zinc-400 hover:bg-zinc-100 hover:text-zinc-600"
+          aria-label="关闭"
+        >
+          <X className="h-4 w-4" />
+        </button>
+      </div>
+
+      <div className="mb-3 flex items-center gap-2 rounded-lg bg-zinc-50 px-3 py-2 text-[13px]">
+        <span className={`h-2.5 w-2.5 rounded-full ${comfy ? STATE_TONE[comfy.state] : 'bg-zinc-300'}`} />
+        <span className="font-medium text-zinc-700">
+          ComfyUI {comfy ? STATE_LABEL[comfy.state] : '…'}
+        </span>
+        {comfy?.pid && <span className="text-zinc-400">PID {comfy.pid}</span>}
+        {comfy?.rssMb != null && (
+          <span className="ml-auto text-zinc-500">{(comfy.rssMb / 1024).toFixed(1)} GB 内存</span>
+        )}
+      </div>
+
+      {gpu && (
+        <div className="mb-3 space-y-1 text-[12px] text-zinc-600">
+          <div>
+            {gpu.name} · {gpu.vram_gb.toFixed(1)} GB 显存 · 驱动 {gpu.driver}
+          </div>
+          {health?.plan.notes.map((n) => (
+            <div key={n} className="rounded bg-amber-50 px-2 py-1 text-[11px] text-amber-800">
+              {n}
+            </div>
+          ))}
+        </div>
+      )}
+
+      {missing.length > 0 && (
+        <div className="mb-3 rounded-lg bg-red-50 px-3 py-2 text-[12px] text-red-700">
+          缺少模型：{missing.join('、')}
+        </div>
+      )}
+
+      {current && (
+        <div className="mb-3 rounded-lg border border-blue-100 bg-blue-50/60 px-3 py-2 text-[12px]">
+          <div className="flex items-center justify-between font-medium text-blue-900">
+            <span>
+              正在{current.kind === 'video' ? '生成视频' : '出图'} · {current.route}
+            </span>
+            <span>
+              {current.state === 'preparing' ? '加载模型…' : `${current.step}/${current.totalSteps}`}
+            </span>
+          </div>
+          <div className="mt-1.5 h-1.5 overflow-hidden rounded-full bg-blue-100">
+            <div
+              className="h-full rounded-full bg-blue-500 transition-[width]"
+              style={{ width: `${Math.max(3, current.progress * 100)}%` }}
+            />
+          </div>
+          <div className="mt-1 flex justify-between text-[11px] text-blue-700/80">
+            <span>已用 {fmtDuration(current.elapsed)}</span>
+            {current.loadSecs != null && <span>加载 {fmtDuration(current.loadSecs)}</span>}
+          </div>
+        </div>
+      )}
+
+      {queued > 0 && (
+        <div className="mb-3 text-[12px] text-zinc-500">队列中还有 {queued} 个任务</div>
+      )}
+
+      {error && (
+        <div className="mb-3 rounded-lg bg-red-50 px-3 py-2 text-[12px] text-red-700">{error}</div>
+      )}
+      {comfy?.lastError && comfy.state === 'crashed' && (
+        <div className="mb-3 rounded-lg bg-red-50 px-3 py-2 text-[12px] text-red-700">
+          {comfy.lastError}
+        </div>
+      )}
+
+      <div className="flex flex-wrap gap-2">
+        <button
+          type="button"
+          disabled={busy !== null || comfy?.state === 'ready' || comfy?.state === 'starting'}
+          onClick={() => act('start', startComfy)}
+          className="inline-flex items-center gap-1 rounded-lg border border-zinc-200 px-2.5 py-1.5 text-[12px] font-medium text-zinc-700 hover:bg-zinc-50 disabled:opacity-40"
+        >
+          <Play className="h-3.5 w-3.5" /> 启动
+        </button>
+        <button
+          type="button"
+          disabled={busy !== null || comfy?.state === 'stopped'}
+          onClick={() => act('stop', stopComfy)}
+          className="inline-flex items-center gap-1 rounded-lg border border-zinc-200 px-2.5 py-1.5 text-[12px] font-medium text-zinc-700 hover:bg-zinc-50 disabled:opacity-40"
+        >
+          <CircleStop className="h-3.5 w-3.5" /> 停止
+        </button>
+        <button
+          type="button"
+          disabled={busy !== null}
+          onClick={() => act('restart', restartComfy)}
+          className="inline-flex items-center gap-1 rounded-lg border border-zinc-200 px-2.5 py-1.5 text-[12px] font-medium text-zinc-700 hover:bg-zinc-50 disabled:opacity-40"
+        >
+          <RefreshCw className="h-3.5 w-3.5" /> 重启
+        </button>
+        <button
+          type="button"
+          disabled={busy !== null || comfy?.state !== 'ready'}
+          onClick={() => act('free', freeComfyVram)}
+          title="卸载模型、把显存还给系统；下次生成会重新加载"
+          className="inline-flex items-center gap-1 rounded-lg border border-zinc-200 px-2.5 py-1.5 text-[12px] font-medium text-zinc-700 hover:bg-zinc-50 disabled:opacity-40"
+        >
+          <Trash2 className="h-3.5 w-3.5" /> 释放显存
+        </button>
+        <button
+          type="button"
+          onClick={() => setShowLogs((v) => !v)}
+          className="ml-auto rounded-lg px-2.5 py-1.5 text-[12px] font-medium text-zinc-500 hover:bg-zinc-50"
+        >
+          {showLogs ? '隐藏日志' : '查看日志'}
+        </button>
+      </div>
+
+      {showLogs && (
+        <div
+          ref={logRef}
+          className="mt-3 max-h-56 overflow-auto rounded-lg bg-zinc-900 p-2 font-mono text-[10.5px] leading-relaxed text-zinc-300"
+        >
+          {logs.length === 0 ? (
+            <div className="text-zinc-500">暂无日志</div>
+          ) : (
+            logs.map((l, i) => (
+              <div key={`${i}-${l.slice(0, 24)}`} className="whitespace-pre-wrap break-all">
+                {l}
+              </div>
+            ))
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
