diff --git a/src/canvas/useFlowNodes.ts b/src/canvas/useFlowNodes.ts
new file mode 100644
index 0000000..4c7d495
--- /dev/null
+++ b/src/canvas/useFlowNodes.ts
@@ -0,0 +1,64 @@
+/**
+ * 把画布节点转换成 React Flow 节点，并保持未变化节点的对象引用不变。
+ *
+ * 原实现每次都 `nodes.map(toFlowNode)` 重新构造全部对象。store 用的是 immer，
+ * 未改动的节点本身引用是稳定的，但这一步会把这份稳定性丢掉：任何一次改动
+ * （哪怕只是某个节点的进度百分比）都会让 React Flow 看到 100 个全新对象，
+ * 从而更新全部内部节点状态并重渲染所有节点外壳。
+ *
+ * 这里按节点 id 缓存产物，只有当源节点引用、选中态、连线悬停态之一真的变化时
+ * 才重建那一个对象。
+ */
+import { useMemo, useRef } from 'react';
+import type { Node as RFNode } from '@xyflow/react';
+
+import type { AppNode, NodeId } from '@/types/node';
+
+interface CacheEntry {
+  src: AppNode;
+  selected: boolean;
+  hovered: boolean;
+  out: RFNode;
+}
+
+export function useFlowNodes(
+  nodes: AppNode[],
+  selectedIds: NodeId[],
+  connectHoverTargetId: NodeId | null,
+): RFNode[] {
+  const cache = useRef(new Map<NodeId, CacheEntry>());
+
+  return useMemo(() => {
+    const selected = new Set<NodeId>(selectedIds);
+    const next = new Map<NodeId, CacheEntry>();
+    const out: RFNode[] = [];
+
+    for (const n of nodes) {
+      const isSelected = selected.has(n.id);
+      const isHovered = n.id === connectHoverTargetId;
+      const prev = cache.current.get(n.id);
+
+      if (prev && prev.src === n && prev.selected === isSelected && prev.hovered === isHovered) {
+        next.set(n.id, prev);
+        out.push(prev.out);
+        continue;
+      }
+
+      const flow: RFNode = {
+        id: n.id,
+        type: n.kind,
+        position: { x: n.x, y: n.y },
+        data: {},
+        width: n.width,
+        height: n.height,
+        selected: isSelected,
+        className: isHovered ? 'canvas-node-connect-hover' : undefined,
+      };
+      next.set(n.id, { src: n, selected: isSelected, hovered: isHovered, out: flow });
+      out.push(flow);
+    }
+
+    cache.current = next; // 顺带丢弃已删除节点的缓存
+    return out;
+  }, [nodes, selectedIds, connectHoverTargetId]);
+}
