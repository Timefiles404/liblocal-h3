+import type { ModelDef } from '@/types/model';
+import { request } from './client';
+import { runLocalImage } from './local-bridge';
+import { routeRequest, type RouteCtx, type TaskInput } from './model-routing';
+import { pollTask } from './poll';
+import { resolveTemplate, type Vars } from './template';
+
+export interface ImageGenResult {
+  created?: number;
+  data: Array<{ url?: string; b64_json?: string }>;
+}
+
+interface AsyncInit {
+  task_id?: string;
+  id?: string;
+  status?: string;
+}
+
+export interface GenerateImageOpts {
+  model: ModelDef;
+  baseUrl: string;
+  apiKey?: string;
+  vars: Vars;
+  ctx: RouteCtx;
+  signal?: AbortSignal;
+  timeoutMs?: number;
+}
+
+const TASK: TaskInput = { type: 'image' };
+
+export async function generateImage(opts: GenerateImageOpts): Promise<ImageGenResult> {
+  // 本地渠道在此分流：不需要 baseUrl / apiKey，也不经过模板与路由表。
+  // 放在这一层而不是各个调用点，是为了让角色图、场景图、角色卡、分镜等
+  // 所有出图入口一次性获得本地能力。
+  if (opts.model.provider === 'local') {
+    const refs = Array.isArray(opts.vars.imageUrls)
+      ? (opts.vars.imageUrls as unknown[]).filter((u): u is string => typeof u === 'string')
+      : [];
+    const urls = await runLocalImage({
+      model: opts.model,
+      prompt: typeof opts.vars.prompt === 'string' ? opts.vars.prompt : '',
+      referenceImages: refs,
+      ratio: typeof opts.vars.ratio === 'string' ? opts.vars.ratio : undefined,
+      signal: opts.signal,
+    });
+    return { created: Date.now(), data: urls.map((url) => ({ url })) };
+  }
+
+  const route = routeRequest(TASK, opts.model, opts.ctx);
+  const resolved = resolveTemplate(route.bodyTemplate, opts.vars);
+  const baseUrl = opts.baseUrl.replace(/\/+$/, '');
+  const url = baseUrl + route.endpoint;
+  const body: BodyInit =
+    resolved.kind === 'json' ? JSON.stringify(resolved.body) : resolved.body;
+
+  if (route.async) {
+    const init = await request<AsyncInit>({
+      url,
+      method: 'POST',
+      apiKey: opts.apiKey,
+      body,
+      bodyKind: resolved.kind,
+      signal: opts.signal,
+      timeoutMs: opts.timeoutMs,
+    });
+    const taskId = init.task_id ?? init.id;
+    if (!taskId) throw new Error('Async image response missing task_id');
+    const pollUrl = `${baseUrl}/v1/tasks/${taskId}`;
+    return pollTask<ImageGenResult & AsyncInit>(pollUrl, {
+      apiKey: opts.apiKey,
+      signal: opts.signal,
+      isDone: (r) => {
+        if (r.status === 'completed') return 'completed';
+        if (r.status === 'failed') return 'failed';
+        return 'pending';
+      },
+    });
+  }
+
+  return request<ImageGenResult>({
+    url,
+    method: 'POST',
+    apiKey: opts.apiKey,
+    body,
+    bodyKind: resolved.kind,
+    signal: opts.signal,
+    timeoutMs: opts.timeoutMs,
+  });
+}
