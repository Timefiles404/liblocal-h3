+import type { ProviderAssignment } from './provider';
+
+export type Provider =
+  /** 本地 MiniMax H3（Liblocal 编排器），无需任何 API 配置。 */
+  | 'local'
+  | 'openai'
+  | 'jimeng'
+  | 'midjourney'
+  | 'qwen'
+  | 'deepseek'
+  | 'yunwu'
+  | 'custom';
+
+/** 本地渠道不需要 Key/BaseUrl，凭据界面据此跳过它。 */
+export function isLocalProvider(provider: Provider): boolean {
+  return provider === 'local';
+}
+
+export type Modality = 'image' | 'video' | 'chat';
+
+export interface ModelParameter {
+  key: string;
+  label: string;
+  type: 'text' | 'number' | 'select' | 'boolean';
+  defaultValue: string | number | boolean;
+  min?: number;
+  max?: number;
+  step?: number;
+  options?: Array<{ label: string; value: string }>;
+  description?: string;
+}
+
+export interface ModelDef {
+  id: string;
+  name: string;
+  displayName?: string;
+  provider: Provider;
+  modality: Modality;
+  hidden?: boolean;
+  supportsEdit?: boolean;
+  async?: boolean;
+  ratios?: string[];
+  resolutions?: string[];
+  durations?: string[];
+  defaultImageConcurrency?: number;
+  group?: string;
+  parameters?: ModelParameter[];
+  providerAssignment?: ProviderAssignment;
+}
diff --git a/src/utils/bench.ts b/src/utils/bench.ts
new file mode 100644
index 0000000..3f9bbe2
--- /dev/null
+++ b/src/utils/bench.ts
@@ -0,0 +1,103 @@
+/**
+ * 画布压测入口：`?bench=150` 会铺满 150 个带图的节点并测帧率。
+ *
+ * 存在的理由是“百节点不卡顿”这句话必须能被复现验证，而不是凭感觉。
+ * 只在带 bench 参数时执行，正常使用不受影响。
+ *
+ * 结果打印在控制台，并挂到 `window.__benchResult` 便于自动化读取。
+ */
+import { createInputImageFromDataURL } from '@/canvas/factory';
+import { useCanvas } from '@/store/canvas';
+import type { AppNode } from '@/types/node';
+
+export interface BenchResult {
+  nodes: number;
+  seedMs: number;
+  frames: number;
+  durationMs: number;
+  fps: number;
+  p95FrameMs: number;
+  worstFrameMs: number;
+}
+
+declare global {
+  interface Window {
+    __benchResult?: BenchResult;
+    __benchReady?: boolean;
+  }
+}
+
+/** 生成一张有真实像素的小图，避免测到“空 div”这种不具代表性的情形。 */
+function swatch(i: number): string {
+  const c = document.createElement('canvas');
+  c.width = 256;
+  c.height = 144;
+  const g = c.getContext('2d');
+  if (g) {
+    const hue = (i * 37) % 360;
+    const grad = g.createLinearGradient(0, 0, 256, 144);
+    grad.addColorStop(0, `hsl(${hue} 70% 55%)`);
+    grad.addColorStop(1, `hsl(${(hue + 60) % 360} 70% 35%)`);
+    g.fillStyle = grad;
+    g.fillRect(0, 0, 256, 144);
+    g.fillStyle = 'rgba(255,255,255,0.9)';
+    g.font = 'bold 28px system-ui';
+    g.fillText(String(i), 12, 40);
+  }
+  return c.toDataURL('image/png');
+}
+
+function measureFps(durationMs: number): Promise<Omit<BenchResult, 'nodes' | 'seedMs'>> {
+  return new Promise((resolve) => {
+    const frameTimes: number[] = [];
+    let last = performance.now();
+    const start = last;
+    const tick = (now: number) => {
+      frameTimes.push(now - last);
+      last = now;
+      if (now - start < durationMs) {
+        requestAnimationFrame(tick);
+        return;
+      }
+      const sorted = [...frameTimes].sort((a, b) => a - b);
+      const elapsed = now - start;
+      resolve({
+        frames: frameTimes.length,
+        durationMs: Math.round(elapsed),
+        fps: Number(((frameTimes.length / elapsed) * 1000).toFixed(1)),
+        p95FrameMs: Number((sorted[Math.floor(sorted.length * 0.95)] ?? 0).toFixed(2)),
+        worstFrameMs: Number((sorted[sorted.length - 1] ?? 0).toFixed(2)),
+      });
+    };
+    requestAnimationFrame(tick);
+  });
+}
+
+export async function maybeRunBench(): Promise<void> {
+  const count = Number(new URLSearchParams(window.location.search).get('bench') ?? 0);
+  if (!Number.isFinite(count) || count <= 0) return;
+
+  const t0 = performance.now();
+  const cols = Math.ceil(Math.sqrt(count * 1.6));
+  const nodes: AppNode[] = [];
+  for (let i = 0; i < count; i += 1) {
+    nodes.push(
+      createInputImageFromDataURL(swatch(i), `bench-${i}.png`, {
+        x: (i % cols) * 360,
+        y: Math.floor(i / cols) * 300,
+      }),
+    );
+  }
+  // 一次性灌入，避免 N 次 set 触发 N 次订阅
+  useCanvas.setState({ nodes, edges: [], selectedIds: [] });
+  const seedMs = Math.round(performance.now() - t0);
+
+  // 等布局与首帧稳定后再采样
+  await new Promise((r) => setTimeout(r, 1500));
+  const m = await measureFps(4000);
+  const result: BenchResult = { nodes: count, seedMs, ...m };
+  window.__benchResult = result;
+  window.__benchReady = true;
+  // eslint-disable-next-line no-console
+  console.log('[bench]', JSON.stringify(result));
+}
