+/**
+ * 本地 MiniMax H3 渠道（Liblocal 编排器）。
+ *
+ * 与其它 provider 的区别：不需要任何 API Key 或 base URL 配置。前端由编排器
+ * 自身托管，所以接口一律同源；开发模式下由 vite 代理 `/api` 到编排器。
+ *
+ * 图片走 H3 的“首帧截停”：同一套权重、同一段条件，但只生成最短合法片段
+ * （5 帧，latent_t=2 而不是 37）并取第 0 帧，因此不需要额外的图片模型。
+ */
+
+export type LocalKind = 'image' | 'video';
+
+export interface LocalGenerateParams {
+  kind: LocalKind;
+  prompt: string;
+  /** 档位；显式参数会覆盖档位里的对应项。 */
+  profile?: string;
+  aspect?: string;
+  width?: number;
+  height?: number;
+  /** 帧数（24fps），会被吸附到模型的 17k+5 网格。 */
+  length?: number;
+  steps?: number;
+  seed?: number | null;
+  sampler?: string;
+  scheduler?: string;
+  denoise?: number;
+  shiftVideo?: number;
+  shiftAudio?: number;
+  useTurboLora?: boolean;
+  loraStrength?: number;
+  withAudio?: boolean;
+  fps?: number;
+  /** ComfyUI input 目录内的文件名，由 uploadLocalImage 返回。 */
+  firstFrame?: string;
+  lastFrame?: string;
+  /**
+   * ref2va 参考图（最多 9 张）。与 firstFrame 的区别很关键：参考图只经由文本
+   * 编码器的视觉通路影响生成，不会把任何一帧钉死；提示词中用
+   * `<Picture 1>`、`<Picture 2>` 指代它们。
+   */
+  refImages?: string[];
+  /** match=按输出面积缩放（快）；max=2048 短边，身份保真更好但慢数倍。 */
+  refImageSize?: 'match' | 'max';
+  label?: string;
+}
+
+export interface LocalCost {
+  frameCount: number;
+  latentT: number;
+  audioLatentT: number;
+  durationSec: number;
+  width: number;
+  height: number;
+  videoTokens: number;
+  steps: number;
+  relativeWork: number;
+}
+
+export interface LocalJobOutput {
+  kind: 'image' | 'video' | 'audio' | 'other';
+  filename: string;
+  subfolder: string;
+  url: string;
+}
+
+export interface LocalJob {
+  id: string;
+  kind: LocalKind;
+  route: 't2va' | 'i2va' | 'fl2va' | string;
+  state: 'queued' | 'preparing' | 'running' | 'done' | 'error' | 'cancelled';
+  progress: number;
+  step: number;
+  totalSteps: number;
+  node: string | null;
+  error: string | null;
+  label: string;
+  createdAt: number;
+  startedAt: number | null;
+  finishedAt: number | null;
+  elapsed: number | null;
+  loadSecs: number | null;
+  params: Record<string, unknown>;
+  cost: LocalCost;
+  outputs: LocalJobOutput[];
+}
+
+export interface LocalModelFile {
+  role: string;
+  folder: string;
+  filename: string;
+  required: boolean;
+  present: boolean;
+  sizeGb: number;
+  note: string;
+}
+
+export interface LocalHealth {
+  ok: boolean;
+  version: string;
+  host: {
+    gpu: {
+      name: string;
+      vram_mb: number;
+      vram_gb: number;
+      driver: string;
+      compute_cap: string;
+      is_blackwell: boolean;
+    };
+    ram_gb: number;
+    ram_free_gb: number;
+    cpu_count: number;
+    disk_free_gb: number;
+  };
+  plan: { argv: string[]; notes: string[]; summary: string; tuning: Record<string, unknown> };
+  models: LocalModelFile[];
+  missing: string[];
+  comfy: LocalComfyStatus;
+  paths: { output: string; input: string; logs: string };
+}
+
+export interface LocalComfyStatus {
+  state: 'stopped' | 'starting' | 'ready' | 'stopping' | 'crashed';
+  pid: number | null;
+  port: number;
+  url: string;
+  startedAt: number | null;
+  readyAt: number | null;
+  uptime: number | null;
+  exitCode: number | null;
+  lastError: string | null;
+  restarts: number;
+  rssMb: number | null;
+  tuning: Record<string, unknown> | null;
+}
+
+/** 编排器与前端同源；开发模式由 vite 代理。 */
+const BASE = '';
+
+async function api<T>(path: string, init?: RequestInit): Promise<T> {
+  const res = await fetch(BASE + path, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...(init?.headers ?? {}) },
+  });
+  const text = await res.text();
+  if (!res.ok) {
+    let message = text;
+    try {
+      const parsed = JSON.parse(text) as { error?: string };
+      if (parsed.error) message = parsed.error;
+    } catch {
+      /* 保留原始文本 */
+    }
+    throw new Error(message || `本地服务返回 ${res.status}`);
+  }
+  return (text ? JSON.parse(text) : {}) as T;
+}
+
+export function getLocalHealth(): Promise<LocalHealth> {
+  return api<LocalHealth>('/api/health');
+}
+
+export function getLocalStatus(): Promise<{
+  comfy: LocalComfyStatus;
+  current: LocalJob | null;
+  queued: number;
+  jobs: LocalJob[];
+  modelsLoaded: boolean;
+  idleSecs: number;
+  profiles: Record<string, Record<string, unknown>>;
+  outputDir: string;
+}> {
+  return api('/api/status');
+}
+
+export function startComfy(): Promise<LocalComfyStatus> {
+  return api<LocalComfyStatus>('/api/comfy/start', { method: 'POST' });
+}
+export function stopComfy(): Promise<LocalComfyStatus> {
+  return api<LocalComfyStatus>('/api/comfy/stop', { method: 'POST' });
+}
+export function restartComfy(): Promise<LocalComfyStatus> {
+  return api<LocalComfyStatus>('/api/comfy/restart', { method: 'POST' });
+}
+export function freeComfyVram(): Promise<{ ok: boolean }> {
+  return api('/api/comfy/free', { method: 'POST' });
+}
+export function getComfyLogs(limit = 200): Promise<{
+  logs: Array<{ ts: number; stream: string; text: string }>;
+}> {
+  return api(`/api/comfy/logs?limit=${limit}`);
+}
+
+export function estimateLocal(params: Partial<LocalGenerateParams>): Promise<{
+  cost: LocalCost;
+  route: string;
+}> {
+  return api('/api/estimate', { method: 'POST', body: JSON.stringify(params) });
+}
+
+export function cancelLocalJob(id: string): Promise<{ ok: boolean }> {
+  return api(`/api/jobs/${id}/cancel`, { method: 'POST' });
+}
+
+export function getLocalJob(id: string): Promise<LocalJob> {
+  return api<LocalJob>(`/api/jobs/${id}`);
+}
+
+/** 上传参考图，返回可用作 firstFrame / lastFrame 的文件名。 */
+export async function uploadLocalImage(blob: Blob, filename = 'ref.png'): Promise<string> {
+  const form = new FormData();
+  form.append('image', blob, filename);
+  const res = await fetch(`${BASE}/api/upload`, { method: 'POST', body: form });
+  if (!res.ok) throw new Error(`参考图上传失败：${res.status}`);
+  const data = (await res.json()) as { name: string };
+  return data.name;
+}
+
+/**
+ * 把任意可取到的图片地址（dataURL / blob / http）搬进 ComfyUI 的 input 目录。
+ * 首尾帧必须是本地文件，远端 URL 无法直接交给 LoadImage。
+ */
+export async function stageImageForLocal(url: string): Promise<string> {
+  const res = await fetch(url);
+  if (!res.ok) throw new Error(`读取参考图失败：${res.status}`);
+  const blob = await res.blob();
+  const ext = blob.type.includes('jpeg') ? 'jpg' : blob.type.includes('webp') ? 'webp' : 'png';
+  return uploadLocalImage(blob, `staged-${Date.now()}.${ext}`);
+}
+
+export interface RunLocalOpts extends LocalGenerateParams {
+  signal?: AbortSignal;
+  onProgress?: (job: LocalJob) => void;
+}
+
+const TERMINAL = new Set(['done', 'error', 'cancelled']);
+
+/**
+ * 提交并等待一次本地生成。
+ *
+ * 用轮询而不是 WebSocket：单个任务的生命周期里轮询足够，且不会因为一次断线
+ * 就丢掉正在跑的任务；全局的实时状态由 useLocalRuntime 的 WebSocket 负责。
+ */
+export async function runLocal(opts: RunLocalOpts): Promise<LocalJob> {
+  const { signal, onProgress, ...params } = opts;
+  const job = await api<LocalJob>('/api/generate', {
+    method: 'POST',
+    body: JSON.stringify(params),
+    signal,
+  });
+  onProgress?.(job);
+
+  let current = job;
+  let interval = 700;
+  while (!TERMINAL.has(current.state)) {
+    if (signal?.aborted) {
+      await cancelLocalJob(current.id).catch(() => undefined);
+      throw new DOMException('已取消', 'AbortError');
+    }
+    await new Promise((r) => setTimeout(r, interval));
+    // 采样期间进度变化快，等待权重加载时放慢轮询。
+    interval = current.state === 'running' ? 700 : 1500;
+    try {
+      current = await getLocalJob(current.id);
+      onProgress?.(current);
+    } catch {
+      /* 瞬时错误：下一轮重试，不中断任务 */
+    }
+  }
+
+  if (current.state === 'error') throw new Error(current.error || '本地生成失败');
+  if (current.state === 'cancelled') throw new DOMException('已取消', 'AbortError');
+  return current;
+}
+
+/** 取任务产出中第一个指定类型的文件地址。 */
+export function firstOutputUrl(job: LocalJob, kind: 'image' | 'video'): string | undefined {
+  return job.outputs.find((o) => o.kind === kind)?.url ?? job.outputs[0]?.url;
+}
