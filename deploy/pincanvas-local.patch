+async function persistImageUrl(url: string, name: string): Promise<string> {
+  if (isLocalImageUrl(url)) {
+    const blob = await loadImageBlob(url);
+    return uploadImageMaterial(blob, ensureImageFilename(name, blob.type));
+  }
+  if (isHttpUrl(url)) {
